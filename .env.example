# --- help-bites app ---
APP_URL=http://localhost:3100
ADMIN_URL=http://localhost:3100
# While no operator exists, the first sign-up must enter this (a long random
# string), so whoever reaches a fresh deploy first can't claim it.
SETUP_TOKEN=
# Reverse proxies in front of the app (default 1: Dokploy's Traefik). Per-IP
# rate limits read the client from X-Forwarded-For counting this many entries
# from the right, so a client can't pick its own address. Behind Cloudflare →
# Traefik, set 2.
TRUST_PROXY_HOPS=
# What this container does. all (the default): everything, in one process.
# The hosted stack splits it: web (the panel, the
# API, the widget; scale it out), worker (schedulers, the job queue, pushes;
# whatever must happen once) and embedder (the local embedding model, served to
# the others at /v1/internal/embeddings).
APP_ROLE=
# The image runs the schema and search migrations on boot (1, the default).
# With several app containers, leave it to one and set 0 on the rest.
RUN_MIGRATIONS=
# Where the panel's "Source code" link and /source point. The AGPL asks a
# modified deployment to offer its users the source it runs: set your fork's
# repository. Default: the upstream one.
SOURCE_CODE_URL=
# On upgrade, an install from before workspaces moves its data into one
# workspace with this name (default "HelpBites").
DEFAULT_WORKSPACE_NAME=

# --- Parse (the compose `parse` service; the app is the only master-key holder) ---
PARSE_ID=helpbites
PARSE_MASTER_KEY=change-me-master
PARSE_URL=http://localhost:1337/parse
# Same values the parse container reads (compose passes them through)
PARSE_SERVER_DATABASE_URI=mongodb://sb-mongo:27017/helpbites

# --- Redis (SSE fan-out, rate limits, email throttle) ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch (knowledge hybrid search + app-wide full-text search) ---
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=change-me-meili
# Keep sb-meili private (no domain). If you do give it a public domain, set a
# strong MEILI_MASTER_KEY: MEILI_ENV=production and the endpoint is exposed.
# The app's own key: its three indexes, only the actions it uses (no key
# management, no deleting indexes). `bun run search:key` prints it (in
# production: docker compose exec app bun scripts/meili-key.mjs). Once it is
# set, take MEILI_MASTER_KEY off the app (see docker-compose.yml); sb-meili
# still needs it. Without it the app falls back to the master key, with a warning.
MEILI_API_KEY=

# --- Knowledge embeddings (CLIP text encoder via transformers.js) ---
# Model + device for local, in-process embeddings. Runs on the onnxruntime-node
# backend (Bun/Node), so device must be cpu (default) or cuda (Linux + GPU only);
# wasm/webgpu are browser-only and throw "Unsupported device". Set
# KNOWLEDGE_DISABLE_EMBEDDINGS=1 to run lexical-only. Or point EMBEDDING_ENDPOINT
# at a remote OpenAI-style embeddings service instead of running the model here.
# Only APP_ROLE all or embedder loads the model: a web or worker container
# without EMBEDDING_ENDPOINT runs lexical-only (and says so once).
ICON_EMBEDDING_MODEL=Xenova/clip-vit-large-patch14
ICON_EMBEDDING_DEVICE=
TRANSFORMERS_CACHE=.data/models
KNOWLEDGE_DISABLE_EMBEDDINGS=
EMBEDDING_ENDPOINT=
# Sent as the bearer token to EMBEDDING_ENDPOINT. On the embedder it is also
# the key POST /v1/internal/embeddings asks for; unset there, the route answers
# 404. A long random string (openssl rand -hex 32), the same on every container.
EMBEDDING_API_KEY=

# --- AI support agents (optional auto-reply; off unless an agent enables it) ---
# The email AI designer uses this gateway too, with the models mimo-v2.6-flash
# (High) and mimo-v2.6-pro (Ultra). Per-agent endpoint/key/model override these. Default is a LiteLLM endpoint.
LITELLM_API_BASE_URL=
LITELLM_API_KEY=
LLM_DEFAULT_MODEL=openai/mimo-v2.6-flash

# --- Error tracking (optional GlitchTip and/or Bugsink, Sentry SDK-compatible) ---
# A tracker is offered under Connect error tracking once its URL and token are
# set. Bootstrap the tracker first; docs/ERRORS.md lists the token steps.
GLITCHTIP_URL=http://localhost:8000
GLITCHTIP_TOKEN=
GLITCHTIP_ORG=
GLITCHTIP_TEAM=helpbites
GLITCHTIP_SECRET_KEY=change-me-glitchtip
GLITCHTIP_DB_PASSWORD=change-me-glitchtip-db
GLITCHTIP_RETENTION_DAYS=90
BUGSINK_URL=http://localhost:8001
BUGSINK_TOKEN=
BUGSINK_TEAM=HelpBites
BUGSINK_SECRET_KEY=change-me-bugsink
# Where trackers send alerts. Defaults to APP_URL; override for a host-run dev
# server talking to Compose. GLITCHTIP_WEBHOOK_BASE is still read as a fallback.
ERRORS_WEBHOOK_BASE=http://host.docker.internal:3100
# Optional dogfooding: a HelpBites project DSN for panel + server errors.
NUXT_PUBLIC_SENTRY_DSN=

# --- Default agent for `bun scripts/add-agent.mjs` (args override these) ---
AGENT_USER=
AGENT_PASS=
AGENT_EMAIL=

# --- S3-compatible storage for attachments (any: RustFS, Garage, MinIO, AWS) ---
# Defaults target the bundled RustFS (`--profile dev`), reached over its
# published localhost port for `bun run dev`.
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=help-bites
# Public base URL of the bucket (what ends up in attachment URLs)
S3_PUBLIC_URL=http://localhost:9000/help-bites
# App running inside compose (production) instead of `bun run dev`: point at the
# bundled RustFS over the compose network — set S3_ENDPOINT=sb-rustfs, S3_PORT=
# 9000, S3_USE_SSL=false, S3_BUCKET=help-bites. sb-rustfs reuses S3_ACCESS_KEY /
# S3_SECRET_KEY above (default rustfsadmin — change them). S3_PUBLIC_URL must be
# a URL browsers can reach: attach a domain to sb-rustfs → 9000 and set it here.

# --- Mailgun (the default sender; a project can send from its own address and
# domain of the same Mailgun account: Project → Dev → Email sending) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE_URL=https://api.eu.mailgun.net
MAILGUN_FROM_EMAIL=support@example.com
# Delivery webhooks (delivered, opened, bounced…) → the email log and suppressions.
# Mailgun → Sending → Webhooks → "HTTP webhook signing key"; point the webhooks
# at https://<APP_URL>/v1/webhooks/mailgun.
MAILGUN_WEBHOOK_SIGNING_KEY=
# Days to keep the email log (default 180; 0 keeps everything).
EMAIL_LOG_RETENTION_DAYS=

# --- Changelog notifications ---
# Signs the confirm/unsubscribe links in changelog subscription mail: 32+ random
# characters (openssl rand -base64 48); shorter values are ignored and
# notifications stay off. Leave empty to derive a key from HELPBITES_SECRET.
# Setting or changing it later voids links already sent.
CHANGELOG_LINK_SECRET=
# true = run the changelog scheduler (instant sweep + Monday digest) for projects with changelog.notify on.
ENABLE_CHANGELOG_NOTIFY=

# --- Apple Push Notifications (optional; required only for native push) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.helpbites.operator
# The complete .p8 key body; literal \\n is accepted.
APNS_KEY=
APNS_ENV=sandbox

# --- Contacts & marketing (optional; required for database syncs, campaigns and sequences) ---
# Root of the server's own secrets: seals database credentials for contact
# sources and signs unsubscribe/confirm links. 32+ random characters
# (openssl rand -base64 48). Never change it casually: old unsubscribe links
# and stored credentials stop working. Syncs, campaigns and sequences stay off
# until it is set.
HELPBITES_SECRET=
# Let contact sources reach databases on a private network (10.x, 192.168.x,
# localhost): for self-hosting next to your app's database. Link-local and
# cloud-metadata addresses stay blocked either way.
ALLOW_PRIVATE_NETWORK=
