    "For a plain HTML form, the hosted page and the confirmation link. Empty shows a thank-you page." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per a un formulari HTML senzill, la pàgina allotjada i l'enllaç de confirmació. Buit mostra una pàgina d'agraïment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
