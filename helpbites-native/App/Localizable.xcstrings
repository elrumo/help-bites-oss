    "Who is behind the product, written once." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui hi ha darrere del producte, escrit una sola vegada."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quién está detrás del producto, escrito una sola vez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロダクトの運営者情報を、一度だけ記入します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제품을 만든 주체를 한 번만 작성합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
