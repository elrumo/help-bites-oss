    "Already connected: %@. A new name creates another project; an existing one in the team is reused." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja connectat: %@. Un nom nou crea un altre projecte; un d'existent a l'equip es reutilitza."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya conectado: %@. Un nombre nuevo crea otro proyecto; uno existente en el equipo se reutiliza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続済み: %@。新しい名前を入力すると別のプロジェクトが作成され、チームに既にあるものは再利用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 연결됨: %@. 새 이름을 쓰면 다른 프로젝트가 만들어지고, 팀에 이미 있는 이름이면 그대로 재사용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已连接：%@。使用新名称会创建另一个项目；团队中已有的同名项目会被复用。"
          }
        }
      }
    },
