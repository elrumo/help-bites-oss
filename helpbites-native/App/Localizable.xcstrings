    "This cannot be undone. The linked items stay." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta acció no es pot desfer. Els elements vinculats es conserven."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción no se puede deshacer. Los elementos vinculados se conservan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作は元に戻せません。リンクされた項目は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
