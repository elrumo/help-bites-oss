    "Shown as {{project.address}}; the law requires it in marketing email. This is your company profile's address (Project settings → Company), which legal documents use too." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es mostra com a {{project.address}}; la llei l'exigeix als correus de màrqueting. Aquesta és l'adreça del perfil de la teva empresa (Configuració del projecte → Empresa), que també fan servir els documents legals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra como {{project.address}}; la ley la exige en los correos de marketing. Es la dirección del perfil de tu empresa (Ajustes del proyecto → Empresa), que también usan los documentos legales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{project.address}} として表示されます。マーケティングメールには法律で記載が義務付けられています。これは会社プロフィールの住所（プロジェクト設定 → 会社）で、法的文書にも使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{project.address}}로 표시됩니다. 마케팅 이메일에는 법적으로 필수입니다. 회사 프로필의 주소(프로젝트 설정 → 회사)이며, 법률 문서에도 사용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示为 {{project.address}}；法律要求营销邮件必须包含该信息。这是你公司资料中的地址（项目设置 → 公司），法律文件也会使用它。"
          }
        }
      }
    },
    "Shown at the top of the blog and in the feed; the project's name followed by \"blog\" when empty" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es mostra a dalt del blog i al feed; si és buit, el nom del projecte seguit de \"blog\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra en la parte superior del blog y en el feed; si está vacío, el nombre del proyecto seguido de \"blog\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブログの上部とフィードに表示されます。空の場合はプロジェクト名に「blog」を付けたものになります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "블로그 상단과 피드에 표시됩니다. 비워 두면 프로젝트 이름 뒤에 \"blog\"가 붙습니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
