    "{slug} becomes the page's slug, for example http://localhost:5173/{slug}. Your site must allow being framed by HelpBites." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{slug} es converteix en el slug de la pàgina, per exemple http://localhost:5173/{slug}. El teu lloc ha de permetre que HelpBites l'incrusti en un marc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{slug} se convierte en el slug de la página, por ejemplo http://localhost:5173/{slug}. Tu sitio debe permitir que HelpBites lo incruste en un marco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{slug} はページのスラッグに置き換えられます（例：http://localhost:5173/{slug}）。サイトは HelpBites によるフレーム表示を許可する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{slug}는 페이지의 슬러그로 바뀝니다(예: http://localhost:5173/{slug}). 내 사이트는 HelpBites가 프레임으로 표시하는 것을 허용해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{slug} 会替换为页面的 slug，例如 http://localhost:5173/{slug}。你的网站必须允许被 HelpBites 以框架方式嵌入。"
          }
        }
      }
    },
