    "“%@” is mail the server sends itself, so it can only be shared view-only." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» és correu que el servidor envia ell mateix, així que només es pot compartir en mode de només lectura."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” es correo que envía el propio servidor, así que solo se puede compartir en modo de solo lectura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はサーバー自身が送信するメールのため、閲覧専用でのみ共有できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 서버가 직접 보내는 메일이라 보기 전용으로만 공유할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”是服务器自己发送的邮件，因此只能以仅查看方式共享。"
          }
        }
      }
    },
