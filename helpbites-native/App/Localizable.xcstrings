    "Optional. Only when HelpBites reaches the tracker at another address, such as http://sb-%@:8000 in Compose." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Només quan HelpBites arriba al seguiment des d'una altra adreça, com http://sb-%@:8000 a Compose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Solo cuando HelpBites llega al seguimiento por otra dirección, como http://sb-%@:8000 en Compose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意です。Compose 内の http://sb-%@:8000 のように、HelpBites が別のアドレスでトラッカーに接続する場合のみ入力します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항입니다. Compose의 http://sb-%@:8000처럼 HelpBites가 다른 주소로 추적 도구에 접속할 때만 입력하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选。仅当 HelpBites 通过其他地址访问追踪工具时填写，例如 Compose 中的 http://sb-%@:8000。"
          }
        }
      }
    },
    "Optional. Your app asks for the flow by it; empty makes one from the name." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. La teva app demana el flux amb ella; si es deixa buida, se'n crea una a partir del nom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Tu app pide el flujo con ella; si se deja vacía, se crea una a partir del nombre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意。アプリはこれでフローを指定します。空の場合は名前から作られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항입니다. 앱이 이 값으로 플로우를 요청하며, 비워 두면 이름에서 만들어집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选。你的应用通过它请求引导流程；留空则根据名称生成。"
          }
        }
      }
    },
    "Optional. Your site and app ask for the form by it; empty makes one from the name." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
