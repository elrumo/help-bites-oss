    "Remove %@ from this workspace? They lose access to it at once." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols treure %@ d'aquest espai de treball? En perd l'accés immediatament."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quitar a %@ de este espacio de trabajo? Perderá el acceso de inmediato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ をこのワークスペースから削除しますか？ すぐにアクセスできなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님을 이 워크스페이스에서 제거할까요? 즉시 접근 권한을 잃습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从此工作区移除 %@？对方将立即失去访问权限。"
          }
        }
      }
    },
    "Remove %@?" : {
