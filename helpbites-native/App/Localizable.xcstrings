    "The page answers 404 and the delivery API stops serving it. Your working copy stays." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pàgina respon 404 i l'API de lliurament deixa de servir-la. La teva còpia de treball es conserva."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La página responde 404 y la API de entrega deja de servirla. Tu copia de trabajo se conserva."
          }
