    "Remove “%@” from this project? The shared template stays." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols treure «%@» d'aquest projecte? La plantilla compartida es conserva."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quitar «%@» de este proyecto? La plantilla compartida se conserva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」をこのプロジェクトから外しますか？共有テンプレートは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”을(를) 이 프로젝트에서 제거할까요? 공유 템플릿은 그대로 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从此项目中移除“%@”？共享模板会保留。"
          }
        }
      }
    },
    "Remove %@" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treu %@"
          }
        },
        "es" : {
          "stringUnit" : {
