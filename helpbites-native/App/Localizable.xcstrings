    "Keep your logos, icons, screenshots, colours, fonts and guidelines in one place, and share them on a public page, an embed or the API." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingues els logotips, icones, captures, colors, tipografies i directrius en un sol lloc i comparteix-los en una pàgina pública, una incrustació o l'API."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reúne tus logotipos, iconos, capturas, colores, tipografías y directrices en un solo lugar y compártelos en una página pública, una incrustación o la API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロゴ、アイコン、スクリーンショット、色、フォント、ガイドラインを一か所にまとめ、公開ページ、埋め込み、API で共有できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로고, 아이콘, 스크린샷, 색상, 글꼴, 가이드라인을 한곳에 모아 공개 페이지, 임베드 또는 API로 공유하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把标志、图标、截图、颜色、字体和规范集中在一处，并通过公开页面、嵌入或 API 分享。"
          }
        }
      }
    },
