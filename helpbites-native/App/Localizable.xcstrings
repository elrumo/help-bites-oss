    "The language of the design. The send API's `locale` picks another one; anything else goes out in this." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'idioma del disseny. El `locale` de l'API d'enviament en tria un altre; qualsevol altre cas s'envia en aquest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El idioma del diseño. El `locale` de la API de envío elige otro; en cualquier otro caso se envía en este."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デザインの言語です。送信 API の `locale` で別の言語を指定でき、それ以外の場合はこの言語で送信されます。"
          }
