    "“%@” is saved as “%@”: use letters, digits and _, starting with a letter, and not a reserved name." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» es desa com a «%@»: fes servir lletres, dígits i _, comença amb una lletra i no triïs un nom reservat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» se guarda como «%@»: usa letras, dígitos y _, empieza por una letra y no uses un nombre reservado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は「%@」として保存されます。文字、数字、_ を使い、先頭は文字にして、予約語は避けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) “%@”(으)로 저장됩니다. 문자, 숫자, _를 사용하고 문자로 시작해야 하며 예약어는 쓸 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将保存为“%@”：请使用字母、数字和 _，以字母开头，且不能是保留名称。"
          }
        }
      }
    },
