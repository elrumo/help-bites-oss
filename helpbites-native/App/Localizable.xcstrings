        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`HelpBites.push(['open'])` / `(['close'])`로 패널을 제어합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`HelpBites.push(['open'])` / `(['close'])` 用于控制面板。"
          }
