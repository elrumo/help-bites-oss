      }
    },
    "Disconnect %@?" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols desconnectar %@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Desconectar %@?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の接続を解除しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 연결을 해제할까요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "断开 %@ 的连接？"
          }
        }
      }
    },
    "Disconnect %@? Its credentials and the payments and subscriptions it brought are forgotten. Your other sources are kept." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols desconnectar %@? S'obliden les seves credencials i els pagaments i subscripcions que ha aportat. Les altres fonts es conserven."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Desconectar %@? Se olvidan sus credenciales y los pagos y suscripciones que aportó. Tus otras fuentes se conservan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の接続を解除しますか？認証情報と、そこから取り込んだ支払い・サブスクリプションは破棄されます。ほかのソースはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 연결을 해제할까요? 인증 정보와 이 소스에서 가져온 결제 및 구독은 삭제됩니다. 다른 소스는 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要断开 %@ 吗？它的凭据以及它带来的付款和订阅都会被清除。你的其他来源会保留。"
          }
        }
      }
    },
    "Disconnect Stripe" : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconnecta Stripe"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconectar Stripe"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stripe の接続を解除"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stripe 연결 해제"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "断开 Stripe 连接"
          }
        }
      }
    },
    "Disconnect Stripe from %@? The key and the payments synced from Stripe are forgotten. Contacts keep their Stripe attributes." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols desconnectar Stripe de %@? Se n'oblida la clau i els pagaments sincronitzats des de Stripe. Els contactes conserven els seus atributs de Stripe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Desconectar Stripe de %@? Se olvidan la clave y los pagos sincronizados desde Stripe. Los contactos conservan sus atributos de Stripe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ から Stripe の接続を解除しますか？キーと Stripe から同期した支払いは破棄されます。連絡先の Stripe 属性は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 Stripe 연결을 해제할까요? 키와 Stripe에서 동기화한 결제 내역은 삭제됩니다. 연락처의 Stripe 속성은 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 %@ 断开 Stripe 连接？密钥和从 Stripe 同步的付款记录将被清除。联系人会保留其 Stripe 属性。"
          }
        }
      }
    },
    "Disconnect Stripe? The key and the payments synced from Stripe are forgotten. Contacts keep their Stripe attributes." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols desconnectar Stripe? Se n'oblida la clau i els pagaments sincronitzats des de Stripe. Els contactes conserven els seus atributs de Stripe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Desconectar Stripe? Se olvidan la clave y los pagos sincronizados desde Stripe. Los contactos conservan sus atributos de Stripe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stripe の接続を解除しますか？キーと Stripe から同期した支払いは破棄されます。連絡先の Stripe 属性は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stripe 연결을 해제할까요? 키와 Stripe에서 동기화한 결제 내역은 삭제됩니다. 연락처의 Stripe 속성은 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "断开 Stripe 连接？密钥和从 Stripe 同步的付款记录将被清除。联系人会保留其 Stripe 属性。"
          }
        }
      }
    },
    "Disconnect Telegram from %@? The bot token is forgotten and alerts stop going to the chat." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols desconnectar Telegram de %@? Se n'oblida el token del bot i les alertes deixen d'anar al xat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Desconectar Telegram de %@? Se olvida el token del bot y las alertas dejan de llegar al chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ から Telegram の接続を解除しますか？ボットトークンは破棄され、チャットへのアラート送信は停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 Telegram 연결을 해제할까요? 봇 토큰이 삭제되고 채팅으로 알림이 더 이상 전송되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 %@ 断开 Telegram 连接？机器人令牌将被清除，提醒将不再发送到该聊天。"
          }
        }
      }
    },
