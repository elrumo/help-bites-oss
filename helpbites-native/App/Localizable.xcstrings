    "Connected to %@. One step left: Bugsink can't add alert destinations through its API, so add this webhook by hand." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectat a %@. Només queda un pas: Bugsink no pot afegir destinacions d'alertes mitjançant la seva API, així que afegeix aquest webhook a mà."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectado a %@. Queda un paso: Bugsink no puede añadir destinos de alertas mediante su API, así que añade este webhook a mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ に接続しました。あと 1 ステップです。Bugsink は API でアラートの送信先を追加できないため、この webhook を手動で追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 연결했습니다. 한 단계가 남았습니다. Bugsink는 API로 알림 대상을 추가할 수 없으므로 이 webhook을 직접 추가해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已连接到 %@。还差一步：Bugsink 无法通过 API 添加提醒目标，请手动添加此 webhook。"
          }
        }
      }
    },
