    "Archive a conversation to clear it from the queue. It comes back if the customer writes again." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arxiva una conversa per treure-la de la cua. Torna si el client escriu de nou."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiva una conversación para quitarla de la cola. Vuelve si el cliente escribe de nuevo."
