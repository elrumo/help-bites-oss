          }
        }
      }
    },
    "This workspace has no knowledge model. Create one first, then save answers into it." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest espai de treball no té cap model de coneixement. Crea'n un primer i desa-hi les respostes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este espacio de trabajo no tiene modelo de conocimiento. Crea uno primero y guarda las respuestas en él."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このワークスペースにはナレッジモデルがありません。先に作成してから、回答を保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 워크스페이스에는 지식 모델이 없습니다. 먼저 하나를 만든 다음 답변을 저장하세요."
