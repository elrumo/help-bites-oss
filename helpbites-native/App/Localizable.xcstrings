    "Recorded as their consent. Nobody who unsubscribed is subscribed again." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es registra com a consentiment seu. Ningú que s'hagi donat de baixa tornarà a subscriure's."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se registra como su consentimiento. Nadie que se haya dado de baja vuelve a suscribirse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本人の同意として記録されます。配信停止済みの人が再登録されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본인의 동의로 기록됩니다. 구독을 취소한 사람은 다시 구독되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将记录为对方的同意。已退订的人不会被重新订阅。"
          }
        }
      }
    },
    "Records your panel as the consent source." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra el teu panell com a font del consentiment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra tu panel como fuente del consentimiento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同意の取得元としてパネルが記録されます。"
