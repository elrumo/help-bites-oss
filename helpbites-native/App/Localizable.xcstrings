    "Set MAILGUN_API_KEY, MAILGUN_DOMAIN and MAILGUN_FROM_EMAIL on the server; until then sends fail with 503." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defineix MAILGUN_API_KEY, MAILGUN_DOMAIN i MAILGUN_FROM_EMAIL al servidor; fins aleshores els enviaments fallen amb 503."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define MAILGUN_API_KEY, MAILGUN_DOMAIN y MAILGUN_FROM_EMAIL en el servidor; hasta entonces, los envíos fallan con 503."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーで MAILGUN_API_KEY、MAILGUN_DOMAIN、MAILGUN_FROM_EMAIL を設定してください。それまでは送信が 503 で失敗します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에서 MAILGUN_API_KEY, MAILGUN_DOMAIN, MAILGUN_FROM_EMAIL을 설정하세요. 그 전까지 발송은 503으로 실패합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在服务器上设置 MAILGUN_API_KEY、MAILGUN_DOMAIN 和 MAILGUN_FROM_EMAIL；在此之前发送会以 503 失败。"
          }
        }
      }
    },
    "Set MAILGUN_WEBHOOK_SIGNING_KEY and point Mailgun's webhooks at %@ to see deliveries, opens, bounces and spam reports here." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defineix MAILGUN_WEBHOOK_SIGNING_KEY i apunta els webhooks de Mailgun a %@ per veure aquí entregues, obertures, rebots i informes de spam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define MAILGUN_WEBHOOK_SIGNING_KEY y apunta los webhooks de Mailgun a %@ para ver aquí entregas, aperturas, rebotes y reportes de spam."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MAILGUN_WEBHOOK_SIGNING_KEY を設定し、Mailgun の Webhook を %@ に向けると、配信・開封・不達・スパム報告をここで確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MAILGUN_WEBHOOK_SIGNING_KEY를 설정하고 Mailgun 웹훅을 %@로 지정하면 발송, 열람, 반송, 스팸 신고를 여기서 볼 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 MAILGUN_WEBHOOK_SIGNING_KEY，并将 Mailgun 的 webhook 指向 %@，即可在此查看投递、打开、退回和垃圾邮件举报。"
          }
        }
      }
    },
