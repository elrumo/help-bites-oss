    "This project doesn't keep message content. Turn on **Keep a copy of each email in the log** under Email → Settings to see future messages here." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest projecte no desa el contingut dels missatges. Activa **Guarda una còpia de cada correu al registre** a Correu → Configuració per veure aquí els missatges futurs."
          }
        },
