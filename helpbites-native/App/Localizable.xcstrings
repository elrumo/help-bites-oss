    },
    "Shown in the sidebar, page headers and lists instead of the coloured initial. Square, at least 64×64." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es mostra a la barra lateral, a les capçaleres de pàgina i a les llistes en lloc de la inicial de color. Quadrada, d'almenys 64×64."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra en la barra lateral, en las cabeceras de página y en las listas en lugar de la inicial de color. Cuadrada, de al menos 64×64."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色付きのイニシャルの代わりに、サイドバー、ページヘッダー、リストに表示されます。正方形で、64×64 以上。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색상 이니셜 대신 사이드바, 페이지 헤더, 목록에 표시됩니다. 정사각형, 최소 64×64."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
