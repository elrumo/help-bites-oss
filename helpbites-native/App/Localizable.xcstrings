    },
    "Entries may name one of these (lowercase, comma-separated). Empty allows any." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entrades poden indicar una d'aquestes (en minúscules, separades per comes). Si està buit, s'admet qualsevol."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las entradas pueden indicar una de estas (en minúsculas, separadas por comas). Si está vacío, se admite cualquiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エントリーにはこの中から1つを指定できます（小文字、カンマ区切り）。空欄なら何でも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목은 이 중 하나를 지정할 수 있습니다(소문자, 쉼표로 구분). 비워 두면 아무 값이나 허용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条目可从中选择一个（小写，用逗号分隔）。留空则允许任意值。"
          }
        }
      }
    },
