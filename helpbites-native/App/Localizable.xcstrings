    "Answer a few questions and get a privacy policy, terms, cookie or refund policy built from reviewed clauses." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respon unes quantes preguntes i obtén una política de privacitat, uns termes, una política de cookies o de reemborsament creats a partir de clàusules revisades."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde unas preguntas y obtén una política de privacidad, unos términos, una política de cookies o de reembolso creados a partir de cláusulas revisadas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いくつかの質問に答えるだけで、レビュー済みの条項からプライバシーポリシー、利用規約、Cookie ポリシー、返金ポリシーを作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 가지 질문에 답하면 검토된 조항으로 개인정보 처리방침, 약관, 쿠키 정책, 환불 정책을 만들어 줍니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答几个问题，即可用经过审核的条款生成隐私政策、服务条款、Cookie 政策或退款政策。"
          }
        }
      }
    },
