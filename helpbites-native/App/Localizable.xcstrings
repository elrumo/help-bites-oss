    "Shared templates are read by id with an admin API key. Projects that link this template fetch and send it by their own key." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plantilles compartides es llegeixen per id amb una clau d'API d'administració. Els projectes que enllacen aquesta plantilla l'obtenen i l'envien amb la seva pròpia clau."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las plantillas compartidas se leen por id con una clave de API de administración. Los proyectos que enlazan esta plantilla la obtienen y la envían con su propia clave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有テンプレートは、管理者 API キーを使って ID で取得します。このテンプレートをリンクしているプロジェクトは、それぞれ自身のキーで取得して送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
