    " in Settings to serve its page, JSON and RSS; it does not depend on Feedback." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " a Configuració per servir-ne la pàgina, el JSON i el RSS; no depèn de Comentaris."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " en Ajustes para servir su página, JSON y RSS; no depende de Comentarios."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "を有効にすると、ページ・JSON・RSSが配信されます。フィードバックは不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "을 켜면 페이지, JSON, RSS가 제공됩니다. 피드백은 필요하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以提供其页面、JSON 和 RSS 订阅源；它不需要反馈。"
          }
        }
      }
    },
    " in Settings: until then posts are only here, even published ones." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " a Configuració: fins aleshores les entrades només són aquí, fins i tot les publicades."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " en Ajustes: hasta entonces las entradas solo están aquí, incluso las publicadas."
