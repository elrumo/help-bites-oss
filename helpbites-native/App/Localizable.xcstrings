    "Sign in to the other HelpBites with an owner or admin. We read it once, in the background, and sign out again." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia la sessió a l'altre HelpBites amb un propietari o administrador. El llegim una sola vegada, en segon pla, i tanquem la sessió."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en el otro HelpBites con un propietario o administrador. Lo leemos una sola vez, en segundo plano, y cerramos la sesión."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーナーまたは管理者として、もう一方の HelpBites にログインします。バックグラウンドで一度だけ読み取り、その後ログアウトします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소유자 또는 관리자 계정으로 다른 HelpBites에 로그인하세요. 백그라운드에서 한 번만 읽은 뒤 다시 로그아웃합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用所有者或管理员账户登录另一个 HelpBites。我们会在后台读取一次，然后退出登录。"
          }
        }
      }
    },
