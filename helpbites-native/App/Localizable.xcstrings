    "Tell the people this entry answers. Nothing is sent until you press Send." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa les persones a qui respon aquesta entrada. No s'envia res fins que premis Envia."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa a las personas a quienes responde esta entrada. No se envía nada hasta que pulses Enviar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエントリーが対応している相手に知らせます。送信を押すまで何も送られません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 항목이 답하는 사람들에게 알립니다. 보내기를 누르기 전에는 아무것도 전송되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告知此条目所回应的人。在你点击发送之前不会发出任何内容。"
          }
        }
      }
    },
