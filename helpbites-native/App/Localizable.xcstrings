    "Left blank, alerts go to the project's notify emails (%@)." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si es deixa en blanc, les alertes van als correus de notificació del projecte (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se deja en blanco, las alertas van a los correos de notificación del proyecto (%@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空欄の場合、通知はプロジェクトの通知先メール（%@）に送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비워 두면 프로젝트의 알림 이메일(%@)로 전송됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空时，提醒会发送到项目的通知邮箱（%@）。"
