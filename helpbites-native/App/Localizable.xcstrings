    "Based on %lld unresolved error%@: titles, locations and counts. Open an error to analyze its stack trace." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basat en %lld error%@ sense resoldre: títols, ubicacions i recomptes. Obre un error per analitzar-ne la traça de pila."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basado en %lld error%@ sin resolver: títulos, ubicaciones y recuentos. Abre un error para analizar su traza de pila."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未解決エラー %lld 件%@のタイトル、場所、件数に基づきます。エラーを開くと、そのスタックトレースを分析できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미해결 오류 %lld개%@의 제목, 위치, 횟수를 바탕으로 합니다. 오류를 열면 스택 트레이스를 분석할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基于 %lld 个未解决错误%@的标题、位置和次数。打开某个错误即可分析其堆栈跟踪。"
          }
        }
      }
    },
