    "Read every charge again? This picks up refunds on old payments and can take a while." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols tornar a llegir tots els cobraments? Així es detecten els reemborsaments de pagaments antics i pot trigar una estona."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Volver a leer todos los cobros? Así se detectan los reembolsos de pagos antiguos y puede tardar un rato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての請求を再読み込みしますか？古い支払いの返金も反映されますが、時間がかかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 청구 내역을 다시 읽을까요? 오래된 결제의 환불도 반영되며 시간이 걸릴 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新读取所有扣款？这会同步旧付款的退款，可能需要一些时间。"
          }
        }
      }
    },
