    "Reprocess to re-import without duplicating; replace to upload a new version." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprocessa per reimportar sense duplicar; substitueix per pujar una versió nova."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprocesar para reimportar sin duplicar; reemplazar para subir una versión nueva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重複させずに再インポートするには再処理、新しいバージョンをアップロードするには置き換えを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중복 없이 다시 가져오려면 다시 처리, 새 버전을 업로드하려면 교체를 사용하세요."
          }
