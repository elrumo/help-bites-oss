    "Lowercase letters, digits, _ and -, starting with a letter; not a key already in use" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lletres minúscules, dígits, _ i -, començant per una lletra; no pot ser una clau ja en ús"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letras minúsculas, dígitos, _ y -, empezando por una letra; no puede ser una clave ya en uso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小文字の英字、数字、_ と - を使い、英字で始めてください。すでに使われているキーは使えません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소문자, 숫자, _ 및 -만 사용하고 문자로 시작하세요. 이미 사용 중인 키는 쓸 수 없습니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用小写字母、数字、_ 和 -，以字母开头；不能与已有的键重复"
          }
        }
      }
    },
    "Lowercase words and dashes, / between folders; home is the site's root" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
