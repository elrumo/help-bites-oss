    "Detach" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desvincula"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desvincular"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンク解除"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 해제"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消关联"
          }
        }
      }
    },
    "Detach from the shared template? This project gets its own editable copy, and later edits to the shared template no longer reach it." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols desvincular-la de la plantilla compartida? Aquest projecte tindrà la seva pròpia còpia editable, i els canvis posteriors a la plantilla compartida ja no hi arribaran."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Desvincular de la plantilla compartida? Este proyecto tendrá su propia copia editable, y los cambios posteriores en la plantilla compartida ya no le llegarán."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有テンプレートとのリンクを解除しますか？このプロジェクトは編集可能な独自のコピーを持ち、以後共有テンプレートへの変更は反映されなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 템플릿과의 연결을 해제할까요? 이 프로젝트는 편집 가능한 자체 복사본을 갖게 되며, 이후 공유 템플릿의 변경 사항은 반영되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消与共享模板的关联？此项目将获得自己的可编辑副本，之后对共享模板的修改将不再同步。"
          }
        }
      }
    },
