    },
    "`{{project.name}}`, `{{project.logoUrl}}`, `{{project.url}}`, `{{project.company}}`, `{{project.address}}`, `{{project.email}}`, `{{project.privacyUrl}}`, `{{project.termsUrl}}`. Buttons in the shared template's brand colour take the project accent." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`{{project.name}}`, `{{project.logoUrl}}`, `{{project.url}}`, `{{project.company}}`, `{{project.address}}`, `{{project.email}}`, `{{project.privacyUrl}}`, `{{project.termsUrl}}`. Els botons amb el color de marca de la plantilla compartida prenen l'accent del projecte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`{{project.name}}`, `{{project.logoUrl}}`, `{{project.url}}`, `{{project.company}}`, `{{project.address}}`, `{{project.email}}`, `{{project.privacyUrl}}`, `{{project.termsUrl}}`. Los botones con el color de marca de la plantilla compartida toman el acento del proyecto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`{{project.name}}`, `{{project.logoUrl}}`, `{{project.url}}`, `{{project.company}}`, `{{project.address}}`, `{{project.email}}`, `{{project.privacyUrl}}`, `{{project.termsUrl}}`。共有テンプレートのブランドカラーのボタンには、プロジェクトのアクセントカラーが適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`{{project.name}}`, `{{project.logoUrl}}`, `{{project.url}}`, `{{project.company}}`, `{{project.address}}`, `{{project.email}}`, `{{project.privacyUrl}}`, `{{project.termsUrl}}`. 공유 템플릿의 브랜드 색상 버튼에는 프로젝트 강조색이 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`{{project.name}}`, `{{project.logoUrl}}`, `{{project.url}}`, `{{project.company}}`, `{{project.address}}`, `{{project.email}}`, `{{project.privacyUrl}}`, `{{project.termsUrl}}`。共享模板中使用品牌色的按钮会采用项目的强调色。"
          }
        }
      }
    },
    "`context` is attached to new conversations so you know what the user was looking at. Update it with `HelpBites.push(['setContext', {…}])`." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`context` s'adjunta a les converses noves perquè sàpigues què mirava l'usuari. Actualitza'l amb `HelpBites.push(['setContext', {…}])`."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`context` se adjunta a las conversaciones nuevas para que sepas qué estaba mirando el usuario. Actualízalo con `HelpBites.push(['setContext', {…}])`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`context` は新しい会話に添付され、ユーザーが何を見ていたかが分かります。更新するには `HelpBites.push(['setContext', {…}])` を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`context`는 새 대화에 첨부되어 사용자가 무엇을 보고 있었는지 알 수 있습니다. `HelpBites.push(['setContext', {…}])`로 업데이트하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`context` 会附加到新对话上，让你知道用户当时在看什么。用 `HelpBites.push(['setContext', {…}])` 来更新它。"
          }
        }
      }
    },
    "`data-mode=\"inline\"` with `data-target=\"#selector\"` drops the chat inside an element of your page — a message panel instead of a floating launcher. It fills its container, so give that element a height." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`data-mode=\"inline\"` amb `data-target=\"#selector\"` posa el xat dins un element de la teva pàgina: un panell de missatges en lloc d'un llançador flotant. Omple el seu contenidor, així que dona una alçada a aquest element."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`data-mode=\"inline\"` con `data-target=\"#selector\"` coloca el chat dentro de un elemento de tu página: un panel de mensajes en lugar de un lanzador flotante. Llena su contenedor, así que dale una altura a ese elemento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`data-mode=\"inline\"` と `data-target=\"#selector\"` を指定すると、チャットをページ内の要素に配置できます。フローティングのランチャーではなく、メッセージパネルになります。コンテナいっぱいに表示されるので、その要素には高さを指定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`data-mode=\"inline\"`과 `data-target=\"#selector\"`를 쓰면 채팅이 플로팅 런처 대신 페이지의 요소 안에 메시지 패널로 들어갑니다. 컨테이너를 가득 채우므로 해당 요소에 높이를 지정하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`data-mode=\"inline\"` 配合 `data-target=\"#selector\"`，可把聊天放进页面中的某个元素里——是消息面板，而不是浮动启动按钮。它会撑满所在容器，所以请为该元素设置高度。"
          }
        }
      }
    },
    "`data-position=\"left\"` and `data-accent=\"#hex\"` on the script tag tweak the launcher." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`data-position=\"left\"` i `data-accent=\"#hex\"` a l'etiqueta script ajusten el llançador."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`data-position=\"left\"` y `data-accent=\"#hex\"` en la etiqueta script ajustan el lanzador."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "script タグに `data-position=\"left\"` と `data-accent=\"#hex\"` を指定すると、ランチャーを調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "script 태그에 `data-position=\"left\"`와 `data-accent=\"#hex\"`를 지정하면 런처를 조정할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 script 标签上加 `data-position=\"left\"` 和 `data-accent=\"#hex\"` 即可调整启动按钮。"
          }
        }
      }
    },
    "`GET /v1/events` is server-sent events. Use `fetch` plus a stream reader so the token stays in a header." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`GET /v1/events` són server-sent events. Fes servir `fetch` amb un lector de flux perquè el token es quedi en una capçalera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`GET /v1/events` son server-sent events. Usa `fetch` con un lector de flujo para que el token vaya en una cabecera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`GET /v1/events` は Server-Sent Events です。トークンをヘッダーに載せたままにするため、`fetch` とストリームリーダーを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`GET /v1/events`는 server-sent events입니다. 토큰을 헤더에 유지하려면 `fetch`와 스트림 리더를 사용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`GET /v1/events` 是 server-sent events。请使用 `fetch` 加流读取器，这样令牌可以保留在请求头中。"
          }
        }
      }
    },
    "`getToken` is called when the chat opens and again whenever a token expires." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`getToken` es crida quan s'obre el xat i de nou cada cop que un token caduca."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`getToken` se llama cuando se abre el chat y de nuevo cada vez que un token caduca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`getToken` はチャットを開いたときと、トークンの期限が切れるたびに呼び出されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`getToken`은 채팅이 열릴 때와 토큰이 만료될 때마다 호출됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`getToken` 会在聊天打开时调用，并在每次令牌过期时再次调用。"
          }
        }
      }
    },
    "`HelpBites.push(['open'])` / `(['close'])` control the panel." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`HelpBites.push(['open'])` / `(['close'])` controlen el panell."
          }
        },
        "es" : {
