    },
    "Everyone on your team can open this project and every other one." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tots els membres del teu equip poden obrir aquest projecte i tots els altres."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los miembros de tu equipo pueden abrir este proyecto y todos los demás."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チームの全員がこのプロジェクトと他のすべてのプロジェクトを開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팀의 모든 구성원이 이 프로젝트와 다른 모든 프로젝트를 열 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "团队中的每个人都可以打开此项目和其他所有项目。"
          }
        }
      }
    },
    "Everyone sees the title and excerpt; the rest is for readers signed in with your app or with their email. The feed carries only the excerpt." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tothom veu el títol i l'extracte; la resta és per als lectors que han iniciat sessió amb la teva app o amb el correu. El feed només inclou l'extracte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos ven el título y el extracto; el resto es para los lectores que han iniciado sesión con tu app o con su correo. El feed solo incluye el extracto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルと抜粋は誰でも見られます。それ以外は、アプリまたはメールでサインインした読者のみが読めます。フィードには抜粋だけが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제목과 발췌는 모두에게 보이며, 나머지는 앱 또는 이메일로 로그인한 독자만 볼 수 있습니다. 피드에는 발췌만 포함됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有人都能看到标题和摘要；其余内容仅限通过你的应用或邮箱登录的读者阅读。订阅源只包含摘要。"
          }
        }
      }
    },
    "Everything" : {
      "localizations" : {
