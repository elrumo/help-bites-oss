          }
        }
      }
    },
    "Its saved credentials are forgotten. The contacts it brought in stay." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se n'obliden les credencials desades. Els contactes que ha portat es mantenen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se olvidan sus credenciales guardadas. Los contactos que trajo se mantienen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みの認証情報は削除されます。取り込まれた連絡先はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 자격 증명은 삭제됩니다. 가져온 연락처는 그대로 남습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的凭据将被清除。已导入的联系人会保留。"
          }
        }
      }
    },
    "Its text is deleted when you save. Apps that ask for it get the original." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El seu text s'elimina en desar. Les apps que el demanin rebran l'original."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su texto se elimina al guardar. Las apps que lo pidan recibirán el original."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存するとこのテキストは削除されます。この言語を要求するアプリには原文が返されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하면 이 텍스트가 삭제됩니다. 이를 요청하는 앱은 원본을 받습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存时会删除其文本。请求它的应用将获得原文。"
          }
        }
      }
    },
    "Its text is deleted. Emails asked for it go out in %@." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El seu text s'elimina. Els correus que el demanin s'enviaran en %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su texto se elimina. Los correos que lo pidan saldrán en %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストは削除されます。この言語で依頼されたメールは %@ で送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 텍스트가 삭제됩니다. 이 언어로 요청된 이메일은 %@(으)로 발송됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
