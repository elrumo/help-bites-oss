    "Entries are made of it, such as a product or a blog post." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entrades en deriven, com ara un producte o una publicació del blog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las entradas se crean a partir de él, como un producto o una entrada del blog."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "商品やブログ記事など、エントリーはこれをもとに作られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제품이나 블로그 글처럼 항목이 이것으로 만들어집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
