    "Paste this where the blog should appear. Hand it your user's identity token to let them react and comment (see the Blog guide)." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enganxa això allà on hagi d'aparèixer el blog. Passa-li el token d'identitat del teu usuari perquè pugui reaccionar i comentar (consulta la guia del Blog)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega esto donde deba aparecer el blog. Pásale el token de identidad de tu usuario para que pueda reaccionar y comentar (consulta la guía del Blog)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブログを表示したい場所に貼り付けてください。ユーザーのIDトークンを渡すと、リアクションやコメントができます(ブログガイド参照)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "블로그를 표시할 위치에 붙여넣으세요. 사용자의 ID 토큰을 전달하면 반응과 댓글을 달 수 있습니다(블로그 가이드 참조)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴到博客要显示的位置。传入用户的身份令牌,即可让他们回应和评论(见博客指南)。"
          }
        }
