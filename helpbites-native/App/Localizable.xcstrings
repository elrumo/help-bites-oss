    "This block's component no longer exists. Its data is kept, and it shows as nothing on the page." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El component d'aquest bloc ja no existeix. Les seves dades es conserven i a la pàgina no es mostra res."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El componente de este bloque ya no existe. Sus datos se conservan y en la página no se muestra nada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このブロックのコンポーネントはもう存在しません。データは保持されますが、ページには何も表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 블록의 컴포넌트가 더 이상 존재하지 않습니다. 데이터는 유지되지만 페이지에는 아무것도 표시되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此区块的组件已不存在。其数据会保留，但在页面上不会显示任何内容。"
          }
        }
      }
    },
    "This cannot be undone." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
