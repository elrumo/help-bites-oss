    "Which sections show, in order. A section with nothing in it is left out." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quines seccions es mostren, per ordre. Una secció buida s'omet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué secciones se muestran, en orden. Una sección vacía se omite."
          }
