          }
        }
      }
    },
    "Three steps, about ten minutes." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres passos, uns deu minuts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres pasos, unos diez minutos."
          }
        },
        "ja" : {
