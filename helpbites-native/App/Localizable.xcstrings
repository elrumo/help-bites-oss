    "Legal documents" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documents legals"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documentos legales"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "法的文書"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "법률 문서"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "法律文件"
          }
        }
      }
    },
    "Legal documents name you as the operator, campaigns print your address in every footer, and email templates can fill in your company name, address, email and legal page links." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els documents legals et nomenen com a responsable, les campanyes imprimeixen la teva adreça a cada peu i les plantilles de correu poden omplir el nom de l'empresa, l'adreça, el correu i els enllaços a les pàgines legals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los documentos legales te nombran como responsable, las campañas imprimen tu dirección en cada pie y las plantillas de correo pueden rellenar el nombre de tu empresa, la dirección, el correo y los enlaces a las páginas legales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "法的文書にはあなたが運営者として記載され、キャンペーンの全フッターに住所が印刷され、メールテンプレートには会社名、住所、メールアドレス、法的ページへのリンクを差し込めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "법률 문서에 운영자로 표기되고, 캠페인의 모든 푸터에 주소가 인쇄되며, 이메일 템플릿에 회사 이름, 주소, 이메일, 법률 페이지 링크를 채울 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "法律文件会将你列为运营方，营销活动会在每个页脚印上你的地址，邮件模板可以自动填入公司名称、地址、邮箱和法律页面链接。"
          }
        }
      }
    },
    "Legal name" : {
      "localizations" : {
