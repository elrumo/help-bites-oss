    "Only admins and owners can change the workspace's settings." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només els administradors i propietaris poden canviar la configuració de l'espai de treball."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los administradores y propietarios pueden cambiar los ajustes del espacio de trabajo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークスペースの設定を変更できるのは管理者とオーナーだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "워크스페이스 설정은 관리자와 소유자만 변경할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有管理员和所有者可以更改工作区设置。"
          }
        }
      }
    },
    "Only admins and owners can connect or disconnect accounts." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només els administradors i propietaris poden connectar o desconnectar comptes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los administradores y propietarios pueden conectar o desconectar cuentas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントの接続と解除ができるのは管理者とオーナーだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 연결 및 연결 해제는 관리자와 소유자만 할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有管理员和所有者可以连接或断开账户。"
          }
        }
      }
    },
    "Only admins can see the Stripe products and prices. You can still edit the words." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només els administradors poden veure els productes i preus de Stripe. Pots continuar editant els textos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los administradores pueden ver los productos y precios de Stripe. Aun así puedes editar los textos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stripe の商品と価格は管理者のみ表示できます。文章は引き続き編集できます。"
