    "See every recipient" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra tots els destinataris"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ver todos los destinatarios"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての受信者を表示"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 수신자 보기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看所有收件人"
          }
        }
      }
    },
    "See revenue, subscribers and each person's payments next to their conversations. Connect every place you sell through and the numbers add up." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta els ingressos, els subscriptors i els pagaments de cada persona al costat de les seves converses. Connecta tots els llocs on vens i les xifres se sumen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta los ingresos, los suscriptores y los pagos de cada persona junto a sus conversaciones. Conecta todos los sitios donde vendes y las cifras se suman."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収益、購読者、各ユーザーの支払いを、その人の会話と並べて確認できます。販売している場所をすべて接続すれば、数字が合算されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수익, 구독자, 각 사용자의 결제 내역을 대화와 함께 확인하세요. 판매하는 모든 곳을 연결하면 숫자가 합산됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在对话旁边查看收入、订阅者以及每个人的付款。把你销售的所有渠道都连接起来，数字就会汇总到一起。"
          }
        }
      }
    },
    "See revenue, subscribers and each person's payments next to their conversations. HelpBites only reads from Stripe." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta els ingressos, els subscriptors i els pagaments de cada persona al costat de les seves converses. HelpBites només llegeix de Stripe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta los ingresos, los suscriptores y los pagos de cada persona junto a sus conversaciones. HelpBites solo lee de Stripe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収益、購読者、各ユーザーの支払いを、その人の会話と並べて確認できます。HelpBites は Stripe から読み取るだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수익, 구독자, 각 사용자의 결제 내역을 대화와 함께 확인하세요. HelpBites는 Stripe에서 읽기만 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在对话旁查看收入、订阅者以及每个人的付款记录。HelpBites 只会读取 Stripe 的数据。"
          }
        }
      }
    },
