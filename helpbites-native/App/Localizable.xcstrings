    "Canceled: Pro stays until %@, then the workspace moves to Free. Nothing is deleted." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel·lat: Pro continua fins al %@ i després l'espai de treball passa a Free. No se suprimeix res."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelado: Pro sigue activo hasta el %@ y luego el espacio de trabajo pasa a Free. No se elimina nada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセル済み：%@ まで Pro が続き、その後ワークスペースは Free になります。削除されるものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소됨: %@까지 Pro가 유지되며 이후 워크스페이스는 Free로 전환됩니다. 삭제되는 항목은 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已取消：Pro 保留至 %@，之后工作区将转为 Free。不会删除任何内容。"
          }
        }
      }
    },
