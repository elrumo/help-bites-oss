    "Shown centered at the top of every new chat. Leave blank to hide." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es mostra centrat a la part superior de cada xat nou. Deixa-ho en blanc per amagar-lo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra centrado en la parte superior de cada chat nuevo. Déjalo en blanco para ocultarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいチャットの上部中央に表示されます。空欄にすると非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 채팅의 상단 가운데에 표시됩니다. 비워 두면 숨겨집니다."
          }
