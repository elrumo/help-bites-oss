    "Mailgun's webhook is not set up, so the log never learns about deliveries, opens or bounces and bounced addresses are not suppressed." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El webhook de Mailgun no està configurat, així que el registre mai sap res de lliuraments, obertures ni rebots i les adreces rebotades no se suprimeixen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El webhook de Mailgun no está configurado, así que el registro nunca se entera de entregas, aperturas ni rebotes y las direcciones rebotadas no se suprimen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mailgun の webhook が未設定のため、ログには配信・開封・バウンスが記録されず、バウンスしたアドレスも除外されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mailgun webhook이 설정되지 않아 로그에 전송, 열람, 반송이 기록되지 않고 반송된 주소도 제외되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mailgun 的 webhook 尚未设置，因此日志不会记录投递、打开或退信，退信的地址也不会被屏蔽。"
          }
        }
      }
    },
