        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쉼표로 구분한 주소입니다. 프로젝트에 알림 이메일이 없으므로 하나 이상 추가해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
