    "Checked top to bottom; the first match wins. Match by ticket type and/or keywords in the user's message." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es comproven de dalt a baix; guanya la primera coincidència. Coincideix pel tipus de tiquet i/o per paraules clau del missatge de l'usuari."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se comprueban de arriba abajo; gana la primera coincidencia. Coincide por tipo de ticket y/o por palabras clave del mensaje del usuario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上から順に確認し、最初に一致したルールが適用されます。チケットの種類やユーザーのメッセージ内のキーワードで一致を判定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위에서 아래로 확인하며 처음 일치하는 규칙이 적용됩니다. 티켓 유형 및/또는 사용자 메시지의 키워드로 일치 여부를 판단합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从上到下依次检查，第一个匹配的规则生效。可按工单类型和/或用户消息中的关键词匹配。"
          }
        }
      }
    },
