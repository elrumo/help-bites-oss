    "Stripe → Developers → API keys → Create restricted key, with read access to Charges, Customers, Subscriptions and Products." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stripe → Developers → API keys → Create restricted key, amb accés de lectura a Charges, Customers, Subscriptions i Products."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stripe → Developers → API keys → Create restricted key, con acceso de lectura a Charges, Customers, Subscriptions y Products."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stripe → Developers → API keys → Create restricted key で、Charges、Customers、Subscriptions、Products への読み取り権限を付けて作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stripe → Developers → API keys → Create restricted key에서 Charges, Customers, Subscriptions, Products에 읽기 권한을 부여해 만드세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stripe → Developers → API keys → Create restricted key，并授予 Charges、Customers、Subscriptions 和 Products 的读取权限。"
          }
        }
      }
    },
    "Stripe → Developers → API keys → Create restricted key. Give it read access to Charges, Customers, Subscriptions and Products." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stripe → Developers → API keys → Create restricted key. Dona-li accés de lectura a Charges, Customers, Subscriptions i Products."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stripe → Developers → API keys → Create restricted key. Dale acceso de lectura a Charges, Customers, Subscriptions y Products."
          }
        },
        "ja" : {
