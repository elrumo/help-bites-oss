    "Everyone on it stops getting its emails." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tothom que hi és deixa de rebre'n els correus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los que están en ella dejan de recibir sus correos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参加中の全員に、このシーケンスのメールが届かなくなります。"
