        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聊天会先打开“主页”，展示最新动态、热门反馈和新手引导流程，与“消息”并列。无需公开页面也能使用。"
          }
        }
      }
    },
    "The code behind %@. AI error notes and legal documents read these; HelpBites never writes to them." : {
