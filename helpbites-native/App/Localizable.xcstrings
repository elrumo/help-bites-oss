        }
      }
    },
    "Turn on the changelog first: switch on “Public changelog” in Project → Changelog → Settings. It does not depend on Feedback." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa primer les novetats: activa «Novetats públiques» a Projecte → Novetats → Configuració. No depèn dels comentaris."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa primero el changelog: activa “Changelog público” en Proyecto → Changelog → Ajustes. No depende de Feedback."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先に変更履歴をオンにしてください。プロジェクト → 変更履歴 → 設定で「公開の変更履歴」をオンにします。フィードバックには依存しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 변경 내역을 켜세요. 프로젝트 → 변경 내역 → 설정에서 “공개 변경 내역”을 켜면 됩니다. 피드백과는 별개입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先开启更新日志：在项目 → 更新日志 → 设置中打开“公开更新日志”。它不依赖反馈。"
          }
        }
      }
    },
    "Type" : {
      "localizations" : {
