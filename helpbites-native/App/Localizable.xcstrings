        }
      }
    },
    "This contact has no user id, so they can't follow a post or file one. You can still link an existing post." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest contacte no té identificador d'usuari, així que no pot seguir ni registrar una publicació. Tot i això, pots vincular-ne una d'existent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este contacto no tiene identificador de usuario, así que no puede seguir ni registrar una publicación. Aun así, puedes vincular una existente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この連絡先にはユーザー ID がないため、投稿のフォローや登録はできません。既存の投稿をリンクすることはできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 연락처에는 사용자 ID가 없어 게시물을 팔로우하거나 등록할 수 없습니다. 기존 게시물은 연결할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此联系人没有用户 ID，因此无法关注或提交帖子。你仍可以关联一条现有帖子。"
          }
        }
      }
    },
    "This deletes the document and its versions. Its public page will stop working." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això elimina el document i les seves versions. La seva pàgina pública deixarà de funcionar."
          }
        },
        "es" : {
