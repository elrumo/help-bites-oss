    "Unverified: your replies are emailed to it" : {

    },
    "Up to %lld, comma-separated; readers can filter by them" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fins a %lld, separades per comes; els lectors poden filtrar-hi"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta %lld, separadas por comas; los lectores pueden filtrar por ellas"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大%lld個、カンマ区切り。読者はこれで絞り込めます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 %lld개, 쉼표로 구분하며 독자가 이것으로 필터링할 수 있습니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多 %lld 个，以逗号分隔；读者可据此筛选"
          }
        }
      }
    },
    "Up to 4" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fins a 4"
          }
        },
        "es" : {
          "stringUnit" : {
