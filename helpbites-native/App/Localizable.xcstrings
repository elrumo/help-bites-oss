    },
    "Drawn with your unsaved changes and Stripe's current prices. Buttons do nothing here." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuixada amb els teus canvis sense desar i els preus actuals de Stripe. Aquí els botons no fan res."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibujada con tus cambios sin guardar y los precios actuales de Stripe. Aquí los botones no hacen nada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未保存の変更と Stripe の現在の価格で描画しています。ここではボタンは動作しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하지 않은 변경 사항과 Stripe의 현재 가격으로 그린 화면입니다. 여기서는 버튼이 작동하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你未保存的更改和 Stripe 的当前价格绘制。这里的按钮不会执行任何操作。"
          }
        }
      }
    },
