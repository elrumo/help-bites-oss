        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有运营人员可以打开。"
          }
        }
      }
    },
    "Only origins listed on the project can host the widget; anything else sees an error inside the frame and never gets a token." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només els orígens llistats al projecte poden allotjar el widget; qualsevol altre veu un error dins el marc i no rep cap token."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los orígenes listados en el proyecto pueden alojar el widget; cualquier otro ve un error dentro del marco y nunca recibe un token."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェットを設置できるのはプロジェクトに登録されたオリジンだけです。それ以外ではフレーム内にエラーが表示され、トークンは発行されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트에 등록된 출처에서만 위젯을 호스팅할 수 있습니다. 그 외에는 프레임 안에 오류가 표시되고 토큰도 받지 못합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有项目中列出的来源才能托管小部件；其他来源会在框架内看到错误，也拿不到令牌。"
          }
        }
      }
    },
    "Only people who are subscribed to marketing email are added. Anyone already on the sequence is left alone." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només s'afegeixen les persones subscrites al correu de màrqueting. Les que ja són a la seqüència es deixen tal com estan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se añaden las personas suscritas al correo de marketing. Quienes ya están en la secuencia se dejan como están."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マーケティングメールを購読している人だけが追加されます。すでにシーケンスにいる人はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마케팅 이메일을 구독 중인 사람만 추가됩니다. 이미 시퀀스에 있는 사람은 그대로 둡니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会添加已订阅营销邮件的人。已在该序列中的人不受影响。"
          }
        }
      }
    },
    "Only people who manage the project can see the secret." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només les persones que gestionen el projecte poden veure el secret."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo las personas que gestionan el proyecto pueden ver el secreto."
          }
        },
        "ja" : {
          "stringUnit" : {
