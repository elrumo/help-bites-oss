    "Letters, digits and _, starting with a letter; not a reserved name." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lletres, dígits i _, començant per una lletra; no pot ser un nom reservat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letras, dígitos y _, empezando por una letra; no puede ser un nombre reservado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英字、数字、_ を使い、英字で始めてください。予約語は使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영문자, 숫자, _만 쓰고 영문자로 시작하세요. 예약된 이름은 쓸 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限字母、数字和 _，且以字母开头；不能是保留名称。"
          }
        }
      }
    },
