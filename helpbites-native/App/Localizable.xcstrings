    "Comma-separated addresses. The project has no notify emails, so add at least one." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adreces separades per comes. El projecte no té correus de notificació, així que n'has d'afegir almenys un."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direcciones separadas por comas. El proyecto no tiene correos de notificación, así que añade al menos uno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カンマ区切りのアドレスです。プロジェクトに通知先メールがないため、少なくとも 1 つ追加してください。"
