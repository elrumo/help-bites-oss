            "value" : "你的消息"
          }
        }
      }
    },
    "Your new project's secret is shown above. You can reveal it again here any time; rotating it invalidates tokens minted with the old one." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El secret del teu nou projecte es mostra a dalt. Pots tornar a mostrar-lo aquí en qualsevol moment; rotar-lo invalida els tokens emesos amb l'anterior."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El secreto de tu nuevo proyecto se muestra arriba. Puedes volver a mostrarlo aquí en cualquier momento; rotarlo invalida los tokens emitidos con el anterior."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいプロジェクトのシークレットは上に表示されています。ここからいつでも再表示できます。ローテーションすると、古いシークレットで発行されたトークンは無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 프로젝트의 비밀 키는 위에 표시되어 있습니다. 여기서 언제든 다시 표시할 수 있으며, 교체하면 이전 키로 발급된 토큰은 무효가 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新项目的密钥已显示在上方。你可以随时在此重新显示；轮换密钥会使用旧密钥签发的令牌失效。"
          }
        }
      }
    },
    "Your own links" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els teus propis enllaços"
          }
