        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開ロードマップは公開フィードバックを通じて公開されます。フィードバック → 設定で、ロードマップビューとあわせてオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
